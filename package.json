{
  "name": "arkcompat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @arkcompat/web build",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"{packages,apps,tests}/**/*.{ts,cts,json}\" \"*.{json,yaml,mjs}\" .github/workflows/quality.yml \"apps/web/*.{mjs,html,css}\" \".github/actions/*/*.{mjs,yml}\" \"spikes/**/*.{mjs,ts,json}\" \"scripts/{package-cli,package-deveco,package-release,package-vscode,runtime-notices,runtime-sbom,validate-runtime-provenance}.mjs\"",
    "format:check": "prettier --check \"{packages,apps,tests}/**/*.{ts,cts,json}\" \"*.{json,yaml,mjs}\" .github/workflows/quality.yml \"apps/web/*.{mjs,html,css}\" \".github/actions/*/*.{mjs,yml}\" \"spikes/**/*.{mjs,ts,json}\" \"scripts/{package-cli,package-deveco,package-release,package-vscode,runtime-notices,runtime-sbom,validate-runtime-provenance}.mjs\"",
    "test": "pnpm build && vitest run --coverage",
    "scan": "node apps/cli/dist/index.js scan",
    "explain": "node apps/cli/dist/index.js explain",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && node scripts/validate-docs.mjs",
    "web": "pnpm --filter @arkcompat/web start",
    "evaluate": "node apps/evaluate/dist/index.js",
    "package:cli": "node scripts/package-cli.mjs",
    "package:deveco": "node scripts/package-deveco.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:vscode": "node scripts/package-vscode.mjs",
    "verify:runtime-provenance": "node scripts/validate-runtime-provenance.mjs"
  },
  "devDependencies": {
    "@arkcompat/contracts": "workspace:*",
    "@arkcompat/core": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
