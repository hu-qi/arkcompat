{
  "name": "workspace-root",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-root",
      "version": "1.0.0",
      "workspaces": ["packages/*"],
      "dependencies": {
        "@fixture/alpha": "*"
      }
    },
    "node_modules/@fixture/alpha": {
      "resolved": "packages/alpha",
      "link": true
    },
    "node_modules/@fixture/beta": {
      "resolved": "packages/beta",
      "link": true
    },
    "node_modules/devtool": {
      "version": "1.0.0"
    },
    "node_modules/external": {
      "version": "2.0.0"
    },
    "packages/alpha": {
      "name": "@fixture/alpha",
      "version": "1.0.0",
      "dependencies": {
        "@fixture/beta": "*",
        "external": "^1"
      },
      "devDependencies": {
        "devtool": "^1"
      }
    },
    "packages/alpha/node_modules/external": {
      "version": "1.9.0"
    },
    "packages/beta": {
      "name": "@fixture/beta",
      "version": "1.0.0"
    }
  }
}
