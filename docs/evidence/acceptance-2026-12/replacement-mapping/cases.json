{
  "schemaVersion": "0.1.0",
  "datasetId": "acceptance-replacement-mapping",
  "target": {
    "os": "HarmonyOS",
    "release": "6.0.0",
    "runtime": "arkts",
    "apiLevel": 20
  },
  "cases": [
