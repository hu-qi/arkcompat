{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArkCompat local static API rule snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "rules"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "snapshotId": { "$ref": "#/definitions/id" },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selector", "profile", "source"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "path", "kind"],
            "properties": {
              "module": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?:node:)?[a-zA-Z0-9@._/-]+$"
              },
              "path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z0-9_$-]+$"
                }
              },
              "kind": { "enum": ["call", "construct"] }
            }
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release", "runtime", "apiLevel"],
            "properties": {
              "release": {
                "type": "string",
                "pattern": "^(?:[6-9]|[1-9][0-9]{1,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$"
              },
              "runtime": { "enum": ["arkts", "arkweb", "react-native"] },
              "apiLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "revision"],
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^https://[a-zA-Z0-9.-]+/[a-zA-Z0-9._~/-]*$"
              },
              "revision": { "$ref": "#/definitions/id" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    }
  }
}
